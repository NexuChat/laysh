{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laysh.local/schemas/physics-fragment-1.0.json",
  "title": "Laysh physics expression fragment v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["physics_expressions", "output_names", "brief_summary", "assumptions"],
  "properties": {
    "physics_expressions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "expression"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "expression": {"type": "string", "minLength": 1, "maxLength": 480}
        }
      }
    },
    "output_names": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "brief_summary": {"type": "string", "maxLength": 240},
    "assumptions": {
      "type": "array",
      "maxItems": 8,
      "items": {"type": "string", "maxLength": 180}
    }
  }
}
