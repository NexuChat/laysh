{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laysh.local/schemas/understand-1.2.json",
  "title": "Laysh understanding output v1.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "safe", "unsafe_category", "simulatable", "reason_code", "lang",
    "canonical_intent", "domain", "title", "tldr", "key_formula",
    "learning_objective", "actor", "action", "primary_parameter", "secondary_parameter",
    "misconception", "explanation_prompt", "transfer_prompt",
    "module_spec", "checks", "suggestions"
  ],
  "properties": {
    "safe": {"type": "boolean"},
    "unsafe_category": {
      "type": ["string", "null"],
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "sexual_minors", "self_harm", "graphic_violence", "hate_harassment",
            "wrongdoing", "personal_data", "medical"
          ]
        },
        {"type": "null"}
      ]
    },
    "simulatable": {"type": "boolean"},
    "reason_code": {"type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 64},
    "lang": {"type": "string", "enum": ["ar", "en"]},
    "canonical_intent": {"type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 100},
    "domain": {"type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 64},
    "title": {"type": "string", "maxLength": 120},
    "tldr": {"type": "string", "maxLength": 420},
    "key_formula": {
      "type": ["string", "null"],
      "anyOf": [{"type": "string", "maxLength": 120}, {"type": "null"}]
    },
    "learning_objective": {"type": "string", "maxLength": 220},
    "actor": {
      "type": ["object", "null"],
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "tracking_signature", "tracking_output"],
          "properties": {
            "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64},
            "label": {"type": "string", "maxLength": 80},
            "tracking_signature": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "color_rgb", "tolerance", "reference_color_rgb", "reference_tolerance"
              ],
              "properties": {
                "color_rgb": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {"type": "integer", "minimum": 0, "maximum": 255}
                },
                "tolerance": {"type": "integer", "minimum": 0, "maximum": 48},
                "reference_color_rgb": {
                  "type": ["array", "null"],
                  "anyOf": [
                    {"type": "null"},
                    {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {"type": "integer", "minimum": 0, "maximum": 255}
                    }
                  ]
                },
                "reference_tolerance": {
                  "type": ["integer", "null"],
                  "anyOf": [
                    {"type": "integer", "minimum": 0, "maximum": 48},
                    {"type": "null"}
                  ]
                }
              }
            },
            "tracking_output": {
              "type": ["string", "null"],
              "anyOf": [
                {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                {"type": "null"}
              ]
            }
          }
        }
      ]
    },
    "action": {
      "type": ["string", "null"],
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "rotates", "oscillates", "orbits", "propagates", "flows",
            "floats_sinks", "phases"
          ]
        },
        {"type": "null"}
      ]
    },
    "primary_parameter": {
      "type": ["object", "null"],
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "unit", "min", "max", "default", "step", "sweep_mode"],
          "properties": {
            "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "label": {"type": "string", "maxLength": 80},
            "unit": {"type": "string", "maxLength": 24},
            "min": {"type": "number"},
            "max": {"type": "number"},
            "default": {"type": "number"},
            "step": {"type": "number", "exclusiveMinimum": 0},
            "sweep_mode": {
              "type": "string",
              "enum": ["cyclic", "bounce"],
              "description": "cyclic wraps continuously at the bounds; bounce reverses smoothly at each bound"
            }
          }
        }
      ]
    },
    "secondary_parameter": {
      "type": ["object", "null"],
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "unit", "min", "max", "default", "step"],
          "properties": {
            "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "label": {"type": "string", "maxLength": 80},
            "unit": {"type": "string", "maxLength": 24},
            "min": {"type": "number"},
            "max": {"type": "number"},
            "default": {"type": "number"},
            "step": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      ]
    },
    "misconception": {
      "type": ["string", "null"],
      "description": "For a simulatable lesson, corrective learner copy: explicitly negate the myth and state the truth (Arabic: ليست/ليس/لا … بل …; English: not … but/rather …). Never a bare false claim.",
      "anyOf": [{"type": "string", "maxLength": 180}, {"type": "null"}]
    },
    "explanation_prompt": {
      "type": ["string", "null"],
      "anyOf": [{"type": "string", "maxLength": 180}, {"type": "null"}]
    },
    "transfer_prompt": {
      "type": ["string", "null"],
      "anyOf": [{"type": "string", "maxLength": 180}, {"type": "null"}]
    },
    "module_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputs"],
      "properties": {
        "outputs": {
          "type": "array",
          "maxItems": 8,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        }
      }
    },
    "checks": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "inputs", "output", "expected", "tolerance", "unit"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "kind": {"type": "string", "enum": ["numeric"]},
              "inputs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "value"],
                  "properties": {
                    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                    "value": {"type": "number"}
                  }
                }
              },
              "output": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "expected": {"type": "number"},
              "tolerance": {"type": "number", "minimum": 0},
              "unit": {"type": "string", "maxLength": 24}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id", "kind", "left_inputs", "right_inputs", "output", "relation", "minimum_ratio"
            ],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "kind": {"type": "string", "enum": ["relation"]},
              "left_inputs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "value"],
                  "properties": {
                    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                    "value": {"type": "number"}
                  }
                }
              },
              "right_inputs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "value"],
                  "properties": {
                    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                    "value": {"type": "number"}
                  }
                }
              },
              "output": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "relation": {
                "type": "string",
                "enum": ["right_gt_left", "right_lt_left", "right_eq_left"]
              },
              "minimum_ratio": {"type": "number", "exclusiveMinimum": 0}
            }
          }
        ]
      }
    },
    "suggestions": {
      "type": "array",
      "maxItems": 3,
      "items": {"type": "string", "maxLength": 160}
    }
  }
}
