{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laysh.local/schemas/vision-1.0.json",
  "title": "Laysh semantic vision judgment v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["actor_visible", "action_performed", "physically_consistent", "defects"],
  "properties": {
    "actor_visible": {"type": "boolean"},
    "action_performed": {"type": "boolean"},
    "physically_consistent": {"type": "boolean"},
    "defects": {
      "type": "array",
      "maxItems": 4,
      "items": {"type": "string", "maxLength": 180}
    }
  }
}
