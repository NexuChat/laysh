{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laysh.local/schemas/visual-fragment-2.0.json",
  "title": "Laysh visual command fragment v2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["representation", "background", "commands", "relations", "causal_response"],
  "properties": {
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_pattern", "actor_archetype", "proof_channels", "motion_model"],
      "properties": {
        "scene_pattern": {
          "type": "string",
          "enum": ["world_only", "world_plus_graph", "compare_ab"]
        },
        "actor_archetype": {
          "type": "string",
          "enum": [
            "body",
            "elongated_body",
            "ray_bundle",
            "wave_medium",
            "particle_flow",
            "orbital_pair",
            "linked_bodies",
            "surface_and_body"
          ]
        },
        "proof_channels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["output_name", "carrier", "channel"],
            "properties": {
              "output_name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "carrier": {
                "type": "string",
                "enum": ["actor", "graph", "readout"]
              },
              "channel": {
                "type": "string",
                "enum": ["x", "y", "rotation", "size", "opacity"]
              }
            }
          }
        },
        "motion_model": {
          "type": "string",
          "enum": ["parameter_driven", "time_driven", "cyclic"]
        }
      }
    },
    "background": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top_color", "bottom_color"],
      "properties": {
        "top_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "bottom_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 48,
      "items": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id", "scientific", "clipping_policy", "cx", "cy", "radius", "fill_color", "fill_alt_color", "stroke_color", "line_width", "opacity"],
            "properties": {
              "kind": {"type": "string", "enum": ["circle"]},
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$"},
              "scientific": {"type": "boolean"},
              "clipping_policy": {"type": "string", "enum": ["forbid", "allow"]},
              "cx": {"type": "string", "minLength": 1, "maxLength": 480},
              "cy": {"type": "string", "minLength": 1, "maxLength": 480},
              "radius": {"type": "string", "minLength": 1, "maxLength": 480},
              "fill_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
              "fill_alt_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
              "stroke_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
              "line_width": {"type": "string", "minLength": 1, "maxLength": 480},
              "opacity": {"type": "string", "minLength": 1, "maxLength": 480}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id", "scientific", "clipping_policy", "cx", "cy", "radius_x", "radius_y", "rotation", "fill_color", "fill_alt_color", "stroke_color", "line_width", "opacity"],
            "properties": {
              "kind": {"type": "string", "enum": ["ellipse"]},
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$"},
              "scientific": {"type": "boolean"},
              "clipping_policy": {"type": "string", "enum": ["forbid", "allow"]},
              "cx": {"type": "string", "minLength": 1, "maxLength": 480},
              "cy": {"type": "string", "minLength": 1, "maxLength": 480},
              "radius_x": {"type": "string", "minLength": 1, "maxLength": 480},
              "radius_y": {"type": "string", "minLength": 1, "maxLength": 480},
              "rotation": {"type": "string", "minLength": 1, "maxLength": 480},
              "fill_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
              "fill_alt_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
              "stroke_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
              "line_width": {"type": "string", "minLength": 1, "maxLength": 480},
              "opacity": {"type": "string", "minLength": 1, "maxLength": 480}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id", "scientific", "clipping_policy", "x", "y", "width", "height", "corner_radius", "fill_color", "fill_alt_color", "stroke_color", "line_width", "opacity"],
            "properties": {
              "kind": {"type": "string", "enum": ["rect"]},
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$"},
              "scientific": {"type": "boolean", "enum": [false]},
              "clipping_policy": {"type": "string", "enum": ["forbid", "allow"]},
              "x": {"type": "string", "minLength": 1, "maxLength": 480},
              "y": {"type": "string", "minLength": 1, "maxLength": 480},
              "width": {"type": "string", "minLength": 1, "maxLength": 480},
              "height": {"type": "string", "minLength": 1, "maxLength": 480},
              "corner_radius": {"type": "string", "minLength": 1, "maxLength": 480},
              "fill_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
              "fill_alt_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
              "stroke_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
              "line_width": {"type": "string", "minLength": 1, "maxLength": 480},
              "opacity": {"type": "string", "minLength": 1, "maxLength": 480}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id", "scientific", "clipping_policy", "x1", "y1", "x2", "y2", "stroke_color", "line_width", "opacity"],
            "properties": {
              "kind": {"type": "string", "enum": ["line", "arrow"]},
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$"},
              "scientific": {"type": "boolean", "enum": [false]},
              "clipping_policy": {"type": "string", "enum": ["forbid", "allow"]},
              "x1": {"type": "string", "minLength": 1, "maxLength": 480},
              "y1": {"type": "string", "minLength": 1, "maxLength": 480},
              "x2": {"type": "string", "minLength": 1, "maxLength": 480},
              "y2": {"type": "string", "minLength": 1, "maxLength": 480},
              "stroke_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
              "line_width": {"type": "string", "minLength": 1, "maxLength": 480},
              "opacity": {"type": "string", "minLength": 1, "maxLength": 480}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id", "scientific", "clipping_policy", "x1", "y1", "x2", "y2", "amplitude", "wavelength", "stroke_color", "line_width", "opacity"],
            "properties": {
              "kind": {"type": "string", "enum": ["wave"]},
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$"},
              "scientific": {"type": "boolean"},
              "clipping_policy": {"type": "string", "enum": ["forbid", "allow"]},
              "x1": {"type": "string", "minLength": 1, "maxLength": 480},
              "y1": {"type": "string", "minLength": 1, "maxLength": 480},
              "x2": {"type": "string", "minLength": 1, "maxLength": 480},
              "y2": {"type": "string", "minLength": 1, "maxLength": 480},
              "amplitude": {"type": "string", "minLength": 1, "maxLength": 480},
              "wavelength": {"type": "string", "minLength": 1, "maxLength": 480},
              "stroke_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
              "line_width": {"type": "string", "minLength": 1, "maxLength": 480},
              "opacity": {"type": "string", "minLength": 1, "maxLength": 480}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id", "scientific", "clipping_policy", "x1", "y1", "x2", "y2", "particle_count", "particle_radius", "phase", "fill_color", "stroke_color", "line_width", "opacity"],
            "properties": {
              "kind": {"type": "string", "enum": ["particle_flow"]},
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$"},
              "scientific": {"type": "boolean"},
              "clipping_policy": {"type": "string", "enum": ["forbid", "allow"]},
              "x1": {"type": "string", "minLength": 1, "maxLength": 480},
              "y1": {"type": "string", "minLength": 1, "maxLength": 480},
              "x2": {"type": "string", "minLength": 1, "maxLength": 480},
              "y2": {"type": "string", "minLength": 1, "maxLength": 480},
              "particle_count": {"type": "string", "minLength": 1, "maxLength": 480},
              "particle_radius": {"type": "string", "minLength": 1, "maxLength": 480},
              "phase": {"type": "string", "minLength": 1, "maxLength": 480},
              "fill_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
              "stroke_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
              "line_width": {"type": "string", "minLength": 1, "maxLength": 480},
              "opacity": {"type": "string", "minLength": 1, "maxLength": 480}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id", "scientific", "clipping_policy", "cx", "cy", "rotation", "opacity", "parts"],
            "properties": {
              "kind": {"type": "string", "enum": ["body_group"]},
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$"},
              "scientific": {"type": "boolean"},
              "clipping_policy": {"type": "string", "enum": ["forbid", "allow"]},
              "cx": {"type": "string", "minLength": 1, "maxLength": 480},
              "cy": {"type": "string", "minLength": 1, "maxLength": 480},
              "rotation": {"type": "string", "minLength": 1, "maxLength": 480},
              "opacity": {"type": "string", "minLength": 1, "maxLength": 480},
              "parts": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["kind", "dx", "dy", "radius", "fill_color", "stroke_color", "line_width"],
                      "properties": {
                        "kind": {"type": "string", "enum": ["circle"]},
                        "dx": {"type": "string", "minLength": 1, "maxLength": 480},
                        "dy": {"type": "string", "minLength": 1, "maxLength": 480},
                        "radius": {"type": "string", "minLength": 1, "maxLength": 480},
                        "fill_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
                        "stroke_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
                        "line_width": {"type": "string", "minLength": 1, "maxLength": 480}
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["kind", "dx", "dy", "radius_x", "radius_y", "rotation", "fill_color", "stroke_color", "line_width"],
                      "properties": {
                        "kind": {"type": "string", "enum": ["ellipse"]},
                        "dx": {"type": "string", "minLength": 1, "maxLength": 480},
                        "dy": {"type": "string", "minLength": 1, "maxLength": 480},
                        "radius_x": {"type": "string", "minLength": 1, "maxLength": 480},
                        "radius_y": {"type": "string", "minLength": 1, "maxLength": 480},
                        "rotation": {"type": "string", "minLength": 1, "maxLength": 480},
                        "fill_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
                        "stroke_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
                        "line_width": {"type": "string", "minLength": 1, "maxLength": 480}
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["kind", "dx", "dy", "width", "height", "corner_radius", "fill_color", "stroke_color", "line_width"],
                      "properties": {
                        "kind": {"type": "string", "enum": ["rect"]},
                        "dx": {"type": "string", "minLength": 1, "maxLength": 480},
                        "dy": {"type": "string", "minLength": 1, "maxLength": 480},
                        "width": {"type": "string", "minLength": 1, "maxLength": 480},
                        "height": {"type": "string", "minLength": 1, "maxLength": 480},
                        "corner_radius": {"type": "string", "minLength": 1, "maxLength": 480},
                        "fill_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
                        "stroke_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
                        "line_width": {"type": "string", "minLength": 1, "maxLength": 480}
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["kind", "dx1", "dy1", "dx2", "dy2", "stroke_color", "line_width"],
                      "properties": {
                        "kind": {"type": "string", "enum": ["line"]},
                        "dx1": {"type": "string", "minLength": 1, "maxLength": 480},
                        "dy1": {"type": "string", "minLength": 1, "maxLength": 480},
                        "dx2": {"type": "string", "minLength": 1, "maxLength": 480},
                        "dy2": {"type": "string", "minLength": 1, "maxLength": 480},
                        "stroke_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
                        "line_width": {"type": "string", "minLength": 1, "maxLength": 480}
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id", "scientific", "clipping_policy", "x1", "y1", "angle", "length", "head_size", "stroke_color", "line_width", "opacity"],
            "properties": {
              "kind": {"type": "string", "enum": ["vector_arrow"]},
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$"},
              "scientific": {"type": "boolean"},
              "clipping_policy": {"type": "string", "enum": ["forbid", "allow"]},
              "x1": {"type": "string", "minLength": 1, "maxLength": 480},
              "y1": {"type": "string", "minLength": 1, "maxLength": 480},
              "angle": {"type": "string", "minLength": 1, "maxLength": 480},
              "length": {"type": "string", "minLength": 1, "maxLength": 480},
              "head_size": {"type": "string", "minLength": 1, "maxLength": 480},
              "stroke_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
              "line_width": {"type": "string", "minLength": 1, "maxLength": 480},
              "opacity": {"type": "string", "minLength": 1, "maxLength": 480}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id", "scientific", "clipping_policy", "x1", "y1", "segments", "stroke_color", "line_width", "opacity"],
            "properties": {
              "kind": {"type": "string", "enum": ["ray"]},
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$"},
              "scientific": {"type": "boolean"},
              "clipping_policy": {"type": "string", "enum": ["forbid", "allow"]},
              "x1": {"type": "string", "minLength": 1, "maxLength": 480},
              "y1": {"type": "string", "minLength": 1, "maxLength": 480},
              "segments": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["angle", "length"],
                  "properties": {
                    "angle": {"type": "string", "minLength": 1, "maxLength": 480},
                    "length": {"type": "string", "minLength": 1, "maxLength": 480}
                  }
                }
              },
              "stroke_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
              "line_width": {"type": "string", "minLength": 1, "maxLength": 480},
              "opacity": {"type": "string", "minLength": 1, "maxLength": 480}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id", "scientific", "clipping_policy", "output_name", "sweep", "samples", "stroke_color", "line_width", "opacity"],
            "properties": {
              "kind": {"type": "string", "enum": ["trajectory"]},
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$"},
              "scientific": {"type": "boolean", "enum": [true]},
              "clipping_policy": {"type": "string", "enum": ["forbid", "allow"]},
              "output_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "sweep": {"type": "string", "enum": ["primary_parameter", "time"]},
              "samples": {"type": "integer", "minimum": 8, "maximum": 64},
              "stroke_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
              "line_width": {"type": "string", "minLength": 1, "maxLength": 480},
              "opacity": {"type": "string", "minLength": 1, "maxLength": 480}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id", "scientific", "clipping_policy", "x", "y", "text_ar", "text_en", "color", "font_size", "align", "opacity"],
            "properties": {
              "kind": {"type": "string", "enum": ["text"]},
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$"},
              "scientific": {"type": "boolean", "enum": [false]},
              "clipping_policy": {"type": "string", "enum": ["forbid", "allow"]},
              "x": {"type": "string", "minLength": 1, "maxLength": 480},
              "y": {"type": "string", "minLength": 1, "maxLength": 480},
              "text_ar": {"type": "string", "maxLength": 120},
              "text_en": {"type": "string", "maxLength": 120},
              "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
              "font_size": {"type": "string", "minLength": 1, "maxLength": 480},
              "align": {"type": "string", "enum": ["left", "center", "right"]},
              "opacity": {"type": "string", "minLength": 1, "maxLength": 480}
            }
          }
        ]
      }
    },
    "relations": {
      "type": "array",
      "maxItems": 28,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["objects", "overlap_policy", "contact_policy", "minimum_clearance"],
        "properties": {
          "objects": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$"}
          },
          "overlap_policy": {"type": "string", "enum": ["forbid", "allow", "scientific_occlusion"]},
          "contact_policy": {"type": "string", "enum": ["forbid", "allow", "required"]},
          "minimum_clearance": {"type": "string", "minLength": 1, "maxLength": 480}
        }
      }
    },
    "causal_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "output_name", "channel", "relation", "temporal_mode"],
      "properties": {
        "actor_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$"},
        "output_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "channel": {"type": "string", "enum": ["x", "y", "rotation", "size", "opacity"]},
        "relation": {"type": "string", "enum": ["direct", "inverse"]},
        "temporal_mode": {"type": "string", "enum": ["parameter_driven", "cyclic"]}
      }
    }
  }
}
